&ITERATION
TOL = 1.0d-8,                  !iteration tolerance
TMAX = 5,                !Maximum iteration step
/

&GSIS
ACCFLAG = 0,               !0-CIS, 1-GSIS
/

&VELMSH
NPOLE = 20,                      !# of discrete polar angle
NAZIM = 40,                      !# of discrete azimuthal angle
/

&DG
DEG = 3,                       ! degree of polynomial in DG discretization
/

&FLOW
Cv = 1.d0,                    !specific heat
Vg = 1.d0,                    !magnitude of group velocity
TAU_R = 1.d-3,                      !mean free time of resistive scattering
TAU_N = 1.d5,                     !mean free time of normal scattering
TAU_THR = 1.d0,                    !threhold value in GSIS correction
/

&FILENAME
FNAME_MSH = './A1_Nx11_Ny11.msh',      !file name for spatial mesh
/

&N_BC
NBC = 4,
/

&BC
BC_NAME = 'SWall', 'NWall', 'EWall', 'WWall',   	!Name
BC_PHYID = 11, 12, 13, 14,                   !Physical entity name associated with mesh
BC_TYP = 1, 1, 1, 1, 	                     !Boundary type: 1-thermalisation, 2-nonthermalisation, 3-period
BC_TEMP = 0.d0, 1.d0, 0.d0, 0.d0,         !Temperature
BC_XOFF = 0.d0, 0.d0, 0.d0, 0.d0,            !offset for periodic condition
BC_YOFF = 0.d0, 0.d0, 0.d0, 0.d0,            !offset for periodic condition
/


